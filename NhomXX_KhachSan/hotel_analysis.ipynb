    "arrival_present = arrival_original.notna() & arrival_original.str.strip().ne(\"\")\n",
    "arrival_parsed = pd.Series(pd.NaT, index=df.index, dtype=\"datetime64[ns]\")\n",
    "for date_format in DATE_FORMATS:\n",
    "    candidate = pd.to_datetime(\n",
    "        arrival_original.where(arrival_parsed.isna()),\n",
    "        format=date_format,\n",
    "        errors=\"coerce\",\n",
    "    )\n",
    "    arrival_parsed = arrival_parsed.fillna(candidate)\n",
    "arrival_valid = arrival_parsed.between(ARRIVAL_MIN, ARRIVAL_MAX)\n",
    "arrival_invalid = arrival_present & (arrival_parsed.isna() | ~arrival_valid)\n",
    "arrival_clean = arrival_parsed.where(arrival_valid)\n",
    "log_step(\n",
    "    \"B5\", \"arrival_date\", \"Ngày đến sai định dạng, không tồn tại hoặc ngoài miền\",\n",
    "    \"Đọc riêng 4 format được phép; kiểm tra miền 2015-07-01..2017-08-31\",\n",
    "    \"Chuyển thành datetime; ngày không đọc được/ngoài miền thành thiếu\",\n",
