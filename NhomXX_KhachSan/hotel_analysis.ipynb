    "adr_source = clean_df.copy()\n",
    "adr_source[\"adr\"] = pd.to_numeric(adr_source[\"adr\"], errors=\"coerce\")\n",
    "adr_source[\"is_canceled\"] = pd.to_numeric(adr_source[\"is_canceled\"], errors=\"coerce\")\n",
    "q08_rows = []\n",
    "adr_plot_data = {}\n",
    "for hotel in HOTELS:\n",
    "    hotel_group = adr_source[adr_source[\"hotel\"].eq(hotel) & adr_source[\"is_canceled\"].eq(0)]\n",
    "    positive = hotel_group.loc[hotel_group[\"adr\"].gt(0), \"adr\"].dropna()\n",
    "    adr_plot_data[hotel] = positive\n",
    "    q08_rows.append({\n",
    "        \"hotel\": hotel, \"n_bookings\": len(positive),\n",
    "        \"mean\": positive.mean(), \"median\": positive.median(),\n",
    "        \"min\": positive.min(), \"max\": positive.max(),\n",
    "        \"q1\": positive.quantile(0.25), \"q3\": positive.quantile(0.75),\n",
    "        \"n_adr_zero\": int(hotel_group[\"adr\"].eq(0).sum()),\n",
    "        \"n_adr_missing\": int(hotel_group[\"adr\"].isna().sum()),\n",
    "    })\n",
    "q08 = pd.DataFrame(q08_rows)\n",
    "numeric_stats = [\"mean\", \"median\", \"min\", \"max\", \"q1\", \"q3\"]\n",
    "q08[numeric_stats] = q08[numeric_stats].round(2)\n",
    "save_table(q08, \"q08_adr_stats_by_hotel\")\n",
    "display(q08)\n",
    "all_positive = pd.concat(adr_plot_data.values(), ignore_index=True)\n",
    "bin_upper = max(20, int(((all_positive.max() // 20) + 1) * 20))\n",
    "bins = list(range(0, bin_upper + 20, 20))\n",
    "fig, axes = plt.subplots(1, 2, figsize=(11, 4.5), sharey=True)\n",
    "for ax, hotel in zip(axes, HOTELS):\n",
    "    values = adr_plot_data[hotel]\n",
    "    ax.hist(values, bins=bins, color=HOTEL_COLORS[hotel], edgecolor=\"white\")\n",
    "    ax.set_title(f\"{hotel} (n={len(values)})\")\n",
    "    ax.set_xlabel(\"ADR (EUR/đêm)\")\n",
    "    ax.set_ylabel(\"Số đặt phòng\")\n",
    "    ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "    ax.set_xlim(0, bin_upper)\n",
    "note = (\n",
    "    f\"n = {len(all_positive)} đặt phòng không hủy có adr > 0; \"\n",
    "    f\"loại {int(adr_source['is_canceled'].eq(1).sum())} đặt phòng hủy, \"\n",
    "    f\"{int(adr_source['adr'].eq(0).sum())} adr=0 và {int(adr_source['adr'].isna().sum())} thiếu adr. \"\n",
    "    \"Nguồn: outputs/tables/q08_adr_stats_by_hotel.csv\"\n",
    ")\n",
    "fig.suptitle(\"Phân bố ADR của đặt phòng không hủy\", x=0.01, ha=\"left\", fontweight=\"bold\")\n",
    "fig.text(0.01, -0.02, note, fontsize=9, color=\"#555555\", ha=\"left\", va=\"top\", wrap=True)\n",
    "fig.tight_layout()\n",
    "save_fig(fig, \"fig07_adr_hist\")\n",
    "plt.show()\n"
   ]
