   "source": [
    "stay_source = clean_df.copy()\n",
    "stay_source[\"is_canceled\"] = pd.to_numeric(stay_source[\"is_canceled\"], errors=\"coerce\")\n",
    "stay_source[\"total_nights\"] = pd.to_numeric(stay_source[\"total_nights\"], errors=\"coerce\")\n",
    "stay_valid = stay_source[stay_source[\"is_canceled\"].eq(0) & stay_source[\"total_nights\"].notna()].copy()\n",
    "stay_valid[\"nights_group\"] = stay_valid[\"total_nights\"].clip(upper=15).astype(int).astype(str)\n",
    "stay_valid.loc[stay_valid[\"total_nights\"].ge(15), \"nights_group\"] = \"15+\"\n",
    "stay_order = [str(n) for n in range(15)] + [\"15+\"]\n",
    "stay_counts = stay_valid.groupby([\"nights_group\", \"hotel\"]).size().unstack(fill_value=0)\n",
    "stay_counts = stay_counts.reindex(index=stay_order, columns=HOTELS, fill_value=0)\n",
    "q09 = stay_counts.reset_index().rename(columns={\"index\": \"nights_group\"})\n",
    "q09[\"total\"] = q09[HOTELS].sum(axis=1)\n",
    "q09[\"pct\"] = (q09[\"total\"] / len(stay_valid) * 100).round(2) if len(stay_valid) else 0.0\n",
    "q09 = q09[[\"nights_group\", *HOTELS, \"total\", \"pct\"]]\n",
    "zero_nights = int(stay_valid[\"total_nights\"].eq(0).sum())\n",
    "one_to_three = int(stay_valid[\"total_nights\"].between(1, 3).sum())\n",
    "print(f\"Đặt phòng không hủy có số đêm hợp lệ: {len(stay_valid)}; 0 đêm: {zero_nights}; 1–3 đêm: {one_to_three} ({one_to_three / len(stay_valid) * 100:.2f}%).\")\n",
    "save_table(q09, \"q09_stay_nights\")\n",
    "display(q09)\n",
    "fig, ax = plt.subplots(figsize=(11, 5))\n",
    "x = list(range(len(stay_order)))\n",
    "width = 0.4\n",
    "for offset, hotel in zip((-width / 2, width / 2), HOTELS):\n",
    "    bars = ax.bar([i + offset for i in x], q09[hotel], width=width,\n",
    "                  color=HOTEL_COLORS[hotel], label=hotel)\n",
    "ax.set_xticks(x, stay_order)\n",
    "ax.legend(frameon=False)\n",
    "ax.set_ylim(bottom=0)\n",
    "finish_chart(\n",
    "    ax, \"Số đặt phòng theo tổng số đêm lưu trú\", \"Số đêm (15+ gộp)\", \"Số đặt phòng\",\n",
    "    note=f\"n = {len(stay_valid)} đặt phòng không hủy có total_nights hợp lệ; gồm {zero_nights} đặt phòng 0 đêm. Nguồn: outputs/tables/q09_stay_nights.csv\",\n",
    ")\n",
    "fig.tight_layout()\n",
    "save_fig(fig, \"fig08_stay_nights\")\n",
    "plt.show()\n"
   ]
  },
