   "source": [
    "deposit_labels = clean_df[\"deposit_type\"].astype(\"string\").fillna(\"Unknown\")\n",
    "status_labels = clean_df[\"reservation_status\"].astype(\"string\").fillna(\"Unknown\")\n",
    "q07_source = pd.DataFrame({\"deposit_type\": deposit_labels, \"reservation_status\": status_labels})\n",
    "deposit_order = [value for value in DEPOSITS if value in set(deposit_labels)] + (\n",
    "    [\"Unknown\"] if deposit_labels.eq(\"Unknown\").any() else []\n",
    ")\n",
    "status_order = [\"Check-Out\", \"Canceled\", \"No-Show\", \"Unknown\"]\n",
    "q07_rows = []\n",
    "for deposit in deposit_order:\n",
    "    group = q07_source[q07_source[\"deposit_type\"].eq(deposit)]\n",
    "    denominator = len(group)\n",
    "    for status in status_order:\n",
    "        count = int(group[\"reservation_status\"].eq(status).sum())\n",
    "        q07_rows.append({\n",
    "            \"deposit_type\": deposit,\n",
    "            \"reservation_status\": status,\n",
    "            \"n_bookings\": count,\n",
    "            \"share_pct\": round(count / denominator * 100, 2) if denominator else 0.0,\n",
    "            \"deposit_total\": denominator,\n",
    "        })\n",
    "q07 = pd.DataFrame(q07_rows)\n",
    "save_table(q07, \"q07_deposit_cancel\")\n",
    "display(q07)\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "bottom = [0.0] * len(deposit_order)\n",
    "status_chart_colors = {**STATUS_COLORS, \"Unknown\": \"#9A9A9A\"}\n",
    "for status in status_order:\n",
    "    values = [\n",
    "        float(q07.loc[q07[\"deposit_type\"].eq(deposit) &\n",
    "                      q07[\"reservation_status\"].eq(status), \"share_pct\"].iloc[0])\n",
    "        for deposit in deposit_order\n",
    "    ]\n",
    "    ax.bar(deposit_order, values, bottom=bottom, color=status_chart_colors[status],\n",
    "           label=status, width=0.65)\n",
    "    bottom = [a + b for a, b in zip(bottom, values)]\n",
    "ax.set_ylim(0, 100)\n",
    "ax.legend(title=\"Trạng thái\", frameon=False, ncol=2)\n",
    "finish_chart(\n",
    "    ax, \"Cơ cấu trạng thái trong từng loại đặt cọc\", \"Loại đặt cọc\", \"Tỷ trọng trong loại đặt cọc (%)\",\n",
    "    note=f\"n = {len(q07_source)} đặt phòng; trạng thái thiếu hiển thị Unknown và vẫn nằm trong mẫu số mỗi loại đặt cọc. Nguồn: outputs/tables/q07_deposit_cancel.csv\",\n",
    ")\n",
    "fig.tight_layout()\n",
    "save_fig(fig, \"fig06_deposit_cancel\")\n",
    "plt.show()\n"
   ]
  },
