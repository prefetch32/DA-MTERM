    "ax.bar_label(bars, labels=[f\"{value:.1f}%\" for value in q02[\"cancel_rate_pct\"]], padding=3)\n",
    "ax.set_ylim(0, max(5, float(q02[\"cancel_rate_pct\"].max()) * 1.18))\n",
