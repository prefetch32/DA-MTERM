    "issue_rows = []\n",
    "\n",
    "def add_issue(issue_id, field, issue, rule, mask):\n",
    "    mask = pd.Series(mask, index=raw_df.index).fillna(False).astype(bool)\n",
    "    issue_rows.append({\n",
    "        \"issue_id\": issue_id,\n",
    "        \"field\": field,\n",
    "        \"issue\": issue,\n",
    "        \"detection_rule\": rule,\n",
    "        \"affected_rows\": int(mask.sum()),\n",
    "        \"example_row_ids\": example_ids(raw_df, mask),\n",
    "    })\n",
    "\n",
    "raw_text = {c: raw_df[c].astype(\"string\").str.strip() for c in raw_df.columns}\n",
    "add_issue(\"I01\", \"23 cột nghiệp vụ\", \"Bản ghi trùng tuyệt đối\",\n",
    "          \"duplicated(subset=23 cột, keep='first')\", exact_duplicate_mask)\n",
