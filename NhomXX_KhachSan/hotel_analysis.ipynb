   "source": [
    "INT_RULES = {\n",
    "    \"lead_time\": (0, 800),\n",
    "    \"stays_in_weekend_nights\": (0, 20),\n",
    "    \"stays_in_week_nights\": (0, 50),\n",
    "    \"adults\": (0, 10),\n",
    "    \"children\": (0, 10),\n",
    "    \"babies\": (0, 10),\n",
    "    \"total_of_special_requests\": (0, 5),\n",
    "}\n",
    "\n",
    "def parse_measure(series, allow_nights=False, currency=False):\n",
    "    text = series.astype(\"string\").str.strip()\n",
    "    if allow_nights:\n",
    "        text = text.str.replace(r\"\\s*nights?\\s*$\", \"\", case=False, regex=True)\n", #\s*: có thể có khoảng trắng trước đơn vị. nights?: khớp night hoặc nights. \s*$: bỏ khoảng trắng đến cuối chuỗi.
    "    if currency:\n",
    "        text = text.str.replace(r\"(?:EUR|€|\\ufffd)\", \"\", case=False, regex=True)\n",
    "    text = text.str.replace(r\"\\s+\", \"\", regex=True)\n",
    "    comma_decimal = text.str.contains(\",\", regex=False, na=False) & ~text.str.contains(\".\", regex=False, na=False)\n",
    "    text.loc[comma_decimal] = text.loc[comma_decimal].str.replace(\",\", \".\", regex=False)\n",
    "    return pd.to_numeric(text, errors=\"coerce\")\n",
    "\n",
    "for column, (lo, hi) in INT_RULES.items():\n",
    "    original = df[column].astype(\"string\")\n",
    "    present = original.notna() & original.str.strip().ne(\"\")\n",
    "    numeric = parse_measure(original, allow_nights=column in (\"stays_in_weekend_nights\", \"stays_in_week_nights\"))\n",
    "    valid = numeric.notna() & numeric.mod(1).eq(0) & numeric.between(lo, hi)\n",
    "    invalid = present & ~valid\n",
    "    converted = numeric.where(valid).astype(\"Int64\")\n",
    "    changed = present\n",
    "    df[column] = converted\n",
    "    log_step(\n",
    "        \"B6\", column, \"Chuẩn hóa số nguyên và kiểm tra miền\",\n",
    "        f\"Chuyển số/đuôi nights; số nguyên trong [{lo}, {hi}]\",\n",
    "        \"Chuyển Int64; số không nguyên, không đọc được hoặc ngoài miền thành thiếu\",\n",
    "        int((invalid | (present & original.str.contains(r\"\\.0+$|nights?|\\s\", case=False, regex=True, na=False))).sum()),\n",
    "        int(changed.sum()), 0, example_ids(raw_df, invalid),\n",
    "        \"Giữ số 0 và giá trị hiếm trong miền; không điền giá trị suy đoán.\",\n",
    "        f\"Kiểu Int64, giá trị có dữ liệu nằm trong [{lo}, {hi}].\",\n",
    "    )\n",
    "\n",
    "adr_original = df[\"adr\"].astype(\"string\")\n",
    "adr_present = adr_original.notna() & adr_original.str.strip().ne(\"\")\n",
    "adr_numeric = parse_measure(adr_original, currency=True)\n",
    "adr_valid = adr_numeric.notna() & adr_numeric.between(ADR_MIN, ADR_MAX)\n",
    "adr_invalid = adr_present & ~adr_valid\n",
    "df[\"adr\"] = adr_numeric.where(adr_valid).astype(\"float64\")\n",
    "log_step(\n",
    "    \"B6\", \"adr\", \"Chuẩn hóa giá EUR và kiểm tra miền\",\n",
    "    \"Bỏ EUR/€; đổi dấu phẩy thập phân; số thực trong [0, 1000]\",\n",
    "    \"Chuyển thành float; giá âm, trên 1000, không đọc được thành thiếu\",\n",
    "    int(adr_invalid.sum()), int(adr_present.sum()), 0,\n",
    "    example_ids(raw_df, adr_invalid),\n",
    "    \"adr=0 hợp lệ; không xóa giá trị cao còn trong miền và không gọi là doanh thu.\",\n",
    "    \"adr là số thực trong 0–1000 hoặc thiếu.\",\n",
    ")\n",
    "print(\"Đã chuyển các số đo sang kiểu số và kiểm tra miền.\")\n"
   ]
