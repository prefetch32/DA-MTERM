    "segment_valid = clean_df[clean_df[\"market_segment\"].notna()].copy()\n",
    "missing_segment = int(clean_df[\"market_segment\"].isna().sum())\n",
    "segment_group = segment_valid.groupby(\"market_segment\", sort=False)\n",
    "q06 = segment_group.agg(\n",
    "    n_bookings=(\"booking_id\", \"size\"),\n",
    "    n_canceled=(\"is_canceled\", lambda values: int(values.eq(1).sum())),\n",
    "    n_status=(\"is_canceled\", \"count\"),\n",
    ").reset_index()\n",
    "q06[\"share_pct\"] = q06[\"n_bookings\"] / len(segment_valid) * 100\n",
    "q06[\"cancel_rate_pct\"] = q06[\"n_canceled\"] / q06[\"n_status\"].replace(0, float(\"nan\")) * 100\n",
    "q06[[\"share_pct\", \"cancel_rate_pct\"]] = q06[[\"share_pct\", \"cancel_rate_pct\"]].round(2)\n",
    "print(f\"Đặt phòng thiếu market_segment: {missing_segment} trên {len(clean_df)}.\")\n",
    "display(q06.sort_values(\"n_bookings\", ascending=False))\n",
    "save_table(q06, \"q06_segment_cancel\")\n",
    "segment_plot = q06.sort_values(\"cancel_rate_pct\")\n",
    "fig, ax = plt.subplots(figsize=(9, 5.5))\n",
    "bars = ax.barh(segment_plot[\"market_segment\"], segment_plot[\"cancel_rate_pct\"], color=\"#557C8A\")\n",
    "ax.bar_label(bars, labels=[f\"{x:.1f}%\" for x in segment_plot[\"cancel_rate_pct\"]], padding=3)\n",
    "ax.set_xlim(0, max(5, float(segment_plot[\"cancel_rate_pct\"].max()) * 1.2))\n",
    "finish_chart(\n",
    "    ax, \"Tỷ lệ hủy theo phân khúc thị trường\", \"Tỷ lệ hủy (%)\", \"Phân khúc\",\n",
    "    note=f\"n = {len(segment_valid)} đặt phòng có market_segment; thiếu phân khúc {missing_segment}; tỷ lệ dùng trạng thái hủy đã biết. Nguồn: outputs/tables/q06_segment_cancel.csv\",\n",
    ")\n",
    "fig.tight_layout()\n",
    "save_fig(fig, \"fig05_segment_cancel\")\n",
    "plt.show()\n"
   ]
