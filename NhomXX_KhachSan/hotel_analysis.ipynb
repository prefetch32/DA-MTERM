    "token_set = {str(token).strip().lower() for token in MISSING_TOKENS}\n",
    "for column in df.columns:\n",
    "    if column in (\"row_id\", \"booking_id\"):\n",
    "        continue\n",
    "    before = df[column].astype(\"string\")\n",
    "    empty = before.isna() | before.str.strip().eq(\"\")\n",
    "    token = before.str.strip().str.lower().isin(token_set)\n",
    "    if column == \"meal\":\n",
    "        token &= before.str.strip().str.lower().ne(\"undefined\")\n",
    "    missing_mask = empty | token\n",
    "    changed = missing_mask & before.notna()\n",
    "    if int(missing_mask.sum()):\n",
    "        df.loc[missing_mask, column] = pd.NA\n",
    "        log_step(\n",
    "            \"B3\", column, \"Ô rỗng hoặc ký hiệu thiếu\",\n",
    "            \"Ô rỗng hoặc thuộc NULL/N/A/NA/?/unknown/- (không phân biệt hoa-thường)\",\n",
    "            \"Đổi thành pd.NA; không điền và không xóa dòng\",\n",
    "            int(missing_mask.sum()), int(changed.sum()), 0,\n",
    "            example_ids(raw_df, missing_mask),\n",
    "            \"Giữ thiếu đúng bản chất; Undefined của meal được giữ để ánh xạ thành SC ở B4.\",\n",
    "            \"Không còn chuỗi rỗng hoặc ký hiệu thiếu dạng chữ.\",\n",
    "        )\n",
    "print(\"Đã chuẩn hóa ô rỗng và ký hiệu thiếu; meal=Undefined được giữ cho B4.\")\n"
