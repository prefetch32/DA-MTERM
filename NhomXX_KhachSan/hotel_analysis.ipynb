    "    example_ids(raw_df, arrival_invalid),\n",
    "    \"Đọc ngày/tháng tường minh; không sửa ngày sai theo phỏng đoán.\",\n",
    "    f\"{int(arrival_invalid.sum())} ngày không hợp lệ thành thiếu.\",\n",
    ")\n",
    "df[\"arrival_date\"] = arrival_clean\n",
    "\n",
    "status_original = df[\"reservation_status_date\"].astype(\"string\").str.strip()\n",
    "status_present = status_original.notna() & status_original.ne(\"\")\n",
    "status_parsed = pd.to_datetime(status_original.where(status_present), format=\"%Y-%m-%d\", errors=\"coerce\")\n",
    "status_valid = status_parsed.between(STATUS_MIN, STATUS_MAX)\n",
    "status_invalid = status_present & (status_parsed.isna() | ~status_valid)\n",
    "df[\"reservation_status_date\"] = status_parsed.where(status_valid)\n",
    "log_step(\n",
    "    \"B5\", \"reservation_status_date\", \"Ngày trạng thái không hợp lệ/ngoài miền\",\n",
    "    \"Đọc ISO YYYY-MM-DD và kiểm tra miền 2014-10-01..2017-09-14\",\n",
    "    \"Chuyển thành datetime; giá trị sai/ngoài miền thành thiếu\",\n",
