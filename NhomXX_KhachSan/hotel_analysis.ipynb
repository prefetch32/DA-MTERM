   "source": [
    "missing_tokens = {str(x).strip().lower() for x in MISSING_TOKENS}\n",
    "survey_rows = []\n",
    "for column in raw_df.columns:\n",
    "    text = raw_df[column].astype(\"string\")\n",
    "    empty = text.str.strip().eq(\"\")\n",
    "    token = text.str.strip().str.lower().isin(missing_tokens)\n",
    "    if column in (\"row_id\", \"booking_id\"):\n",
    "        token = pd.Series(False, index=raw_df.index)\n",
    "    empty_count = int(empty.sum())\n",
    "    token_count = int((token & ~empty).sum())\n",
    "    survey_rows.append({\n",
    "        \"column\": column,\n",
    "        \"n_rows\": len(raw_df),\n",
    "        \"empty_count\": empty_count,\n",
    "        \"token_count\": token_count,\n",
    "        \"missing_total\": empty_count + token_count,\n",
    "        \"missing_pct\": round((empty_count + token_count) / len(raw_df) * 100, 2),\n",
    "    })\n",
    "missing_survey = pd.DataFrame(survey_rows)\n",
    "display(missing_survey)\n"
   ]
  },
