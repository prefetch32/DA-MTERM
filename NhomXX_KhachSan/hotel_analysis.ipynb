   "source": [
    "source_2016 = clean_df[pd.to_numeric(clean_df[\"arrival_year\"], errors=\"coerce\").eq(2016)].copy()\n",
    "source_2016[\"arrival_month\"] = pd.to_numeric(source_2016[\"arrival_month\"], errors=\"coerce\")\n",
    "source_2016[\"is_canceled\"] = pd.to_numeric(source_2016[\"is_canceled\"], errors=\"coerce\")\n",
    "monthly_rows = []\n",
    "for month in range(1, 13):\n",
    "    month_group = source_2016[source_2016[\"arrival_month\"].eq(month)]\n",
    "    hotel_counts = {hotel: int(month_group[\"hotel\"].eq(hotel).sum()) for hotel in HOTELS}\n",
    "    known = month_group[\"is_canceled\"].notna()\n",
    "    n_canceled = int(month_group[\"is_canceled\"].eq(1).sum())\n",
    "    denominator = int(known.sum())\n",
    "    monthly_rows.append({\n",
    "        \"arrival_month\": month,\n",
    "        \"City Hotel\": hotel_counts[\"City Hotel\"],\n",
    "        \"Resort Hotel\": hotel_counts[\"Resort Hotel\"],\n",
    "        \"total\": len(month_group),\n",
    "        \"cancel_rate_pct\": round(n_canceled / denominator * 100, 2) if denominator else float(\"nan\"),\n",
    "    })\n",
    "q03 = pd.DataFrame(monthly_rows)\n",
    "save_table(q03, \"q03_monthly_arrivals_2016\")\n",
    "display(q03)\n",
    "for hotel in HOTELS:\n",
    "    row = q03.loc[q03[hotel].eq(q03[hotel].max())].iloc[0]\n",
    "    low = q03.loc[q03[hotel].eq(q03[hotel].min())].iloc[0]\n",
    "    print(f\"{hotel}: cao nhất tháng {int(row['arrival_month'])} ({int(row[hotel])}); thấp nhất tháng {int(low['arrival_month'])} ({int(low[hotel])}).\")\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "for hotel in HOTELS:\n",
    "    ax.plot(q03[\"arrival_month\"], q03[hotel], marker=\"o\",\n",
    "            color=HOTEL_COLORS[hotel], label=hotel, linewidth=2)\n",
    "ax.set_xticks(range(1, 13))\n",
    "ax.legend(frameon=False)\n",
    "ax.set_ylim(bottom=0)\n",
    "finish_chart(\n",
    "    ax, \"Số đặt phòng theo tháng đến, năm 2016\", \"Tháng đến\", \"Số đặt phòng\",\n",
    "    note=f\"n = {len(source_2016)} đặt phòng có ngày đến hợp lệ trong năm 2016; gồm cả đặt phòng hủy. Nguồn: outputs/tables/q03_monthly_arrivals_2016.csv\",\n",
    ")\n",
    "fig.tight_layout()\n",
    "save_fig(fig, \"fig02_monthly_arrivals_2016\")\n",
    "plt.show()\n"
   ]
  },
