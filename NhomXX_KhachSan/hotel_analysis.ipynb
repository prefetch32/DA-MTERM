    "monthly_source = clean_df.copy()\n",
    "monthly_source[\"arrival_year\"] = pd.to_numeric(monthly_source[\"arrival_year\"], errors=\"coerce\")\n",
    "monthly_source[\"arrival_month\"] = pd.to_numeric(monthly_source[\"arrival_month\"], errors=\"coerce\")\n",
    "monthly_source[\"is_canceled\"] = pd.to_numeric(monthly_source[\"is_canceled\"], errors=\"coerce\")\n",
    "monthly_source[\"total_nights\"] = pd.to_numeric(monthly_source[\"total_nights\"], errors=\"coerce\")\n",
    "monthly_source = monthly_source[monthly_source[\"arrival_year\"].notna()]\n",
    "monthly_rows = []\n",
    "for (hotel, year, month), group in monthly_source.groupby(\n",
    "    [\"hotel\", \"arrival_year\", \"arrival_month\"], sort=True\n",
    "):\n",
    "    known_status = group[\"is_canceled\"].notna()\n",
    "    canceled = group[\"is_canceled\"].eq(1)\n",
    "    n_canceled = int(canceled.sum())\n",
    "    denominator = int(known_status.sum())\n",
    "    stayed = group[\"is_canceled\"].eq(0)\n",
    "    monthly_rows.append({\n",
    "        \"hotel\": hotel,\n",
    "        \"arrival_year\": int(year),\n",
    "        \"arrival_month\": int(month),\n",
    "        \"n_bookings\": len(group),\n",
    "        \"n_canceled\": n_canceled,\n",
    "        \"cancel_rate_pct\": round(n_canceled / denominator * 100, 2) if denominator else float(\"nan\"),\n",
    "        \"room_nights\": int(group.loc[stayed, \"total_nights\"].sum()),\n",
    "    })\n",
    "monthly_summary = pd.DataFrame(monthly_rows, columns=SUMMARY_COLUMNS)\n",
    "print(\"Bảng tháng:\", monthly_summary.shape)\n"
   ]
