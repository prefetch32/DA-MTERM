   "source": [
    "q02_rows = []\n",
    "total_bookings = len(clean_df)\n",
    "for hotel in HOTELS:\n",
    "    group = clean_df[clean_df[\"hotel\"].eq(hotel)]\n",
    "    known = group[\"is_canceled\"].notna()\n",
    "    canceled = group[\"is_canceled\"].eq(1).fillna(False)\n",
    "    denominator = int(known.sum())\n",
    "    n_canceled = int(canceled.sum())\n",
    "    q02_rows.append({\n",
    "        \"hotel\": hotel,\n",
    "        \"n_bookings\": len(group),\n",
    "        \"share_pct\": round(len(group) / total_bookings * 100, 2) if total_bookings else float(\"nan\"),\n",
    "        \"n_canceled\": n_canceled,\n",
    "        \"cancel_rate_pct\": round(n_canceled / denominator * 100, 2) if denominator else float(\"nan\"),\n",
