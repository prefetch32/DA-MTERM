   "source": [
    "room_source = clean_df.copy()\n",
    "room_source[\"room_changed_flag\"] = room_source[\"room_changed_flag\"].astype(\"boolean\")\n",
    "checkout = room_source[\"reservation_status\"].eq(\"Check-Out\")\n",
    "room_complete = (\n",
    "    checkout & room_source[\"reserved_room_type\"].notna() &\n",
    "    room_source[\"assigned_room_type\"].notna()\n",
    ")\n",
    "room_valid = room_source[room_complete].copy()\n",
    "q10_rows = []\n",
    "for hotel in HOTELS:\n",
    "    group = room_valid[room_valid[\"hotel\"].eq(hotel)]\n",
    "    n_changed = int(group[\"room_changed_flag\"].sum())\n",
    "    q10_rows.append({\n",
    "        \"hotel\": hotel, \"n_bookings\": len(group),\n",
    "        \"n_room_changed\": n_changed,\n",
    "        \"room_change_rate_pct\": round(n_changed / len(group) * 100, 2) if len(group) else float(\"nan\"),\n",
    "    })\n",
    "q10 = pd.DataFrame(q10_rows)\n",
    "q10b_rows = []\n",
    "for room_type, group in room_valid.groupby(\"reserved_room_type\", sort=True):\n",
    "    n_changed = int(group[\"room_changed_flag\"].sum())\n",
    "    q10b_rows.append({\n",
    "        \"reserved_room_type\": room_type, \"n_bookings\": len(group),\n",
    "        \"n_room_changed\": n_changed,\n",
    "        \"room_change_rate_pct\": round(n_changed / len(group) * 100, 2) if len(group) else float(\"nan\"),\n",
    "    })\n",
    "q10_b = pd.DataFrame(q10b_rows)\n",
    "excluded_room_rows = int((checkout & ~room_source[\"reserved_room_type\"].notna()).sum() +\n",
    "                         (checkout & room_source[\"reserved_room_type\"].notna() &\n",
    "                          ~room_source[\"assigned_room_type\"].notna()).sum())\n",
    "print(f\"Check-Out thiếu ít nhất một loại phòng, bị loại khỏi mẫu số: {excluded_room_rows}.\")\n",
    "save_table(q10, \"q10_room_change_by_hotel\")\n",
    "save_table(q10_b, \"q10_room_change_by_reserved_type\")\n",
    "display(q10)\n",
    "display(q10_b)\n"
   ]
