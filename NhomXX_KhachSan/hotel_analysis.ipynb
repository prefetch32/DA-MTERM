    "clean_df = merged_df.copy()\n",
    "arrival_dates = pd.to_datetime(clean_df[\"arrival_date\"], errors=\"coerce\")\n",
    "clean_df[\"arrival_year\"] = arrival_dates.dt.year.astype(\"Int64\")\n",
    "clean_df[\"arrival_month\"] = arrival_dates.dt.month.astype(\"Int64\")\n",
    "weekend = pd.to_numeric(clean_df[\"stays_in_weekend_nights\"], errors=\"coerce\")\n",
    "week = pd.to_numeric(clean_df[\"stays_in_week_nights\"], errors=\"coerce\")\n",
    "clean_df[\"total_nights\"] = (weekend + week).astype(\"Int64\")\n",
    "adults = pd.to_numeric(clean_df[\"adults\"], errors=\"coerce\")\n",
    "children = pd.to_numeric(clean_df[\"children\"], errors=\"coerce\")\n",
    "babies = pd.to_numeric(clean_df[\"babies\"], errors=\"coerce\")\n",
    "clean_df[\"total_guests\"] = (adults + children + babies).astype(\"Int64\")\n",
    "lead_time = pd.to_numeric(clean_df[\"lead_time\"], errors=\"coerce\")\n",
    "clean_df[\"lead_time_group\"] = pd.cut(\n",
    "    lead_time, bins=[-0.5, 7.5, 30.5, 90.5, 180.5, float(\"inf\")],\n",
    "    labels=LEAD_GROUPS,\n",
    ").astype(\"string\")\n",
    "reserved = clean_df[\"reserved_room_type\"].astype(\"string\")\n",
    "assigned = clean_df[\"assigned_room_type\"].astype(\"string\")\n",
    "clean_df[\"room_changed_flag\"] = (\n",
    "    reserved.notna() & assigned.notna() & reserved.ne(assigned)\n",
    ").fillna(False).astype(bool)\n",
    "adr = pd.to_numeric(clean_df[\"adr\"], errors=\"coerce\")\n",
    "total_nights = pd.to_numeric(clean_df[\"total_nights\"], errors=\"coerce\")\n",
    "is_not_canceled = clean_df[\"is_canceled\"].astype(\"Int64\").eq(0)\n",
    "clean_df[\"revenue_est\"] = (adr * total_nights).where(\n",
    "    is_not_canceled & adr.notna() & total_nights.notna()\n",
    ").round(2)\n",
    "for column in (\"arrival_date\", \"reservation_status_date\"):\n",
    "    clean_df[column] = pd.to_datetime(clean_df[column], errors=\"coerce\").dt.strftime(\"%Y-%m-%d\")\n",
    "clean_df = clean_df[CLEAN_REQUIRED]\n",
    "print(\"Bảng sạch:\", clean_df.shape, \"| booking_id duy nhất:\", clean_df[\"booking_id\"].is_unique)\n"
