    "HOTEL_MAP = {\n",
    "    \"cityhotel\": \"City Hotel\", \"city\": \"City Hotel\",\n",
    "    \"resorthotel\": \"Resort Hotel\", \"resort\": \"Resort Hotel\",\n",
    "}\n",
    "MEAL_MAP = {\n",
    "    \"bb\": \"BB\", \"bandb\": \"BB\", \"halfboard\": \"HB\", \"hb\": \"HB\",\n",
    "    \"fullboard\": \"FB\", \"fb\": \"FB\", \"sc\": \"SC\", \"undefined\": \"SC\",\n",
    "}\n",
    "SEGMENT_MAP = {\n",
    "    \"onlineta\": \"Online TA\", \"offlinetato\": \"Offline TA/TO\", \"groups\": \"Groups\",\n",
    "    \"direct\": \"Direct\", \"corporate\": \"Corporate\", \"complementary\": \"Complementary\",\n",
    "    \"aviation\": \"Aviation\", \"undefined\": pd.NA,\n",
    "}\n",
    "CHANNEL_MAP = {\n",
    "    \"tato\": \"TA/TO\", \"direct\": \"Direct\", \"corporate\": \"Corporate\",\n",
    "    \"gds\": \"GDS\", \"undefined\": pd.NA,\n",
    "}\n",
    "DEPOSIT_MAP = {\n",
    "    \"nodeposit\": \"No Deposit\", \"nonrefund\": \"Non Refund\", \"refundable\": \"Refundable\",\n",
    "}\n",
    "CUSTOMER_MAP = {\n",
    "    \"transient\": \"Transient\", \"transientparty\": \"Transient-Party\",\n",
    "    \"contract\": \"Contract\", \"group\": \"Group\",\n",
    "}\n",
    "STATUS_MAP = {\n",
    "    \"checkout\": \"Check-Out\", \"canceled\": \"Canceled\", \"cancelled\": \"Canceled\",\n",
    "    \"noshow\": \"No-Show\",\n",
    "}\n",
    "\n",
    "def label_key(value):\n",
    "    if pd.isna(value):\n",
    "        return None\n",
    "    return re.sub(r\"[^a-z]\", \"\", str(value).strip().lower())\n",
    "\n",
    "category_maps = {\n",
    "    \"hotel\": HOTEL_MAP, \"meal\": MEAL_MAP, \"market_segment\": SEGMENT_MAP,\n",
    "    \"distribution_channel\": CHANNEL_MAP, \"deposit_type\": DEPOSIT_MAP,\n",
    "    \"customer_type\": CUSTOMER_MAP, \"reservation_status\": STATUS_MAP,\n",
    "}\n",
    "for column, mapping in category_maps.items():\n",
    "    before = df[column].astype(\"string\")\n",
    "    keys = before.map(label_key)\n",
    "    mapped = keys.map(mapping).astype(\"string\")\n",
    "    changed = (before.fillna(\"<NA>\") != mapped.fillna(\"<NA>\"))\n",
    "    newly_missing = before.notna() & mapped.isna()\n",
    "    df[column] = mapped\n",
    "    if int(changed.sum()):\n",
    "        log_step(\n",
    "            \"B4\", column, \"Chuẩn hóa nhãn phân loại\",\n",
    "            \"So khớp khóa chữ thường, bỏ ký tự không phải chữ cái theo từ điển Mục 5.2\",\n",
    "            \"Ánh xạ về nhãn chuẩn; nhãn ngoài từ điển thành thiếu\",\n",
    "            int(changed.sum()), int(changed.sum()), 0,\n",
    "            example_ids(raw_df, changed),\n",
    "            \"Dùng tập nhãn bắt buộc; meal Undefined→SC, segment/channel Undefined→thiếu.\",\n",
    "            f\"Chỉ còn nhãn chuẩn hoặc thiếu; {int(newly_missing.sum())} ô lạ thành thiếu.\",\n",
    "        )\n",
    "\n",
    "bool_map = {\"0\": 0, \"0.0\": 0, \"no\": 0, \"false\": 0, \"1\": 1, \"1.0\": 1, \"yes\": 1, \"true\": 1}\n",
    "for column in (\"is_canceled\", \"is_repeated_guest\"):\n",
    "    before = df[column].astype(\"string\")\n",
    "    mapped = before.str.strip().str.lower().map(bool_map).astype(\"Int64\")\n",
    "    changed = before.fillna(\"<NA>\").ne(mapped.astype(\"string\").fillna(\"<NA>\"))\n",
    "    df[column] = mapped\n",
    "    if int(changed.sum()):\n",
    "        log_step(\n",
    "            \"B4\", column, \"Chuẩn hóa giá trị nhị phân\",\n",
    "            \"Chuyển 0/1, 0.0/1.0, yes/no, true/false về 0/1\",\n",
    "            \"Ánh xạ về Int64; giá trị không hợp lệ thành thiếu\",\n",
    "            int(changed.sum()), int(changed.sum()), 0,\n",
    "            example_ids(raw_df, changed),\n",
    "            \"Quy ước Mục 5.1; không suy đoán giá trị ngoài danh sách.\",\n",
    "            \"Kiểu Int64, chỉ còn 0/1 hoặc thiếu.\",\n",
    "        )\n",
    "\n",
    "for column in (\"reserved_room_type\", \"assigned_room_type\"):\n",
    "    before = df[column].astype(\"string\")\n",
    "    upper = before.str.strip().str.upper()\n",
    "    mapped = upper.where(upper.isin(ROOM_TYPES), pd.NA).astype(\"string\")\n",
    "    changed = before.fillna(\"<NA>\").ne(mapped.fillna(\"<NA>\"))\n",
    "    df[column] = mapped\n",
    "    if int(changed.sum()):\n",
    "        log_step(\n",
    "            \"B4\", column, \"Chuẩn hóa mã loại phòng\",\n",
    "            \"Bỏ khoảng trắng, viết hoa; mã không thuộc tập A B C D E F G H I K L P\",\n",
    "            \"Viết hoa mã hợp lệ; mã ngoài tập thành thiếu\",\n",
    "            int(changed.sum()), int(changed.sum()), 0,\n",
    "            example_ids(raw_df, changed),\n",
    "            \"Giữ mã hợp lệ; không tự đoán mã phòng lạ.\",\n",
    "            \"Mọi mã thuộc tập hợp lệ hoặc thiếu.\",\n",
    "        )\n",
    "\n",
    "status_cancel = df[\"reservation_status\"].map({\"Check-Out\": 0, \"Canceled\": 1, \"No-Show\": 1}).astype(\"Int64\")\n",
    "old_cancel = df[\"is_canceled\"].astype(\"Int64\")\n",
    "status_known = status_cancel.notna()\n",
    "mismatch = status_known & (old_cancel.isna() | old_cancel.ne(status_cancel))\n",
    "df.loc[status_known, \"is_canceled\"] = status_cancel.loc[status_known]\n",
    "if int(mismatch.sum()):\n",
    "    log_step(\n",
    "        \"B4\", \"is_canceled\", \"Mâu thuẫn với trạng thái cuối\",\n",
    "        \"reservation_status hợp lệ nhưng is_canceled thiếu hoặc khác quy tắc Check-Out=0, Canceled/No-Show=1\",\n",
    "        \"Tính lại is_canceled từ reservation_status hợp lệ\",\n",
