    "before_unique_raw = int(raw_df[\"booking_id\"].nunique())\n",
    "before_unique_normalized = int(normalized_ids.nunique())\n",
    "after_unique = int(clean_df[\"booking_id\"].nunique())\n",
    "after_missing = quality_report[quality_report[\"stage\"].eq(\"after\")].set_index(\"column\")\n",
    "q01_rows = [\n",
    "    {\"metric\": \"rows\", \"before\": len(raw_df), \"after\": len(clean_df),\n",
    "     \"note\": \"Trước là dòng nhập; sau là một dòng cho mỗi booking_id.\"},\n",
    "    {\"metric\": \"booking_id_unique_raw\", \"before\": before_unique_raw, \"after\": after_unique,\n",
    "     \"note\": \"booking_id thô có biến thể khoảng trắng/chữ thường; sau chuẩn hóa và gộp.\"},\n",
    "    {\"metric\": \"booking_id_unique_after_normalization\", \"before\": before_unique_normalized, \"after\": after_unique,\n",
    "     \"note\": \"So sánh khóa sau strip().upper() với bảng đặt phòng sạch.\"},\n",
    "    {\"metric\": \"duplicate_rows_23_business_columns\", \"before\": int(exact_duplicate_mask.sum()), \"after\": 0,\n",
    "     \"note\": \"Đếm trên 23 cột nghiệp vụ, bỏ row_id; các dòng được gộp và truy vết.\"},\n",
    "    {\"metric\": \"City_Hotel_exact_label_rows\", \"before\": int(raw_df[\"hotel\"].eq(\"City Hotel\").sum()),\n",
    "     \"after\": int(clean_df[\"hotel\"].eq(\"City Hotel\").sum()),\n",
    "     \"note\": \"Đếm chính xác nhãn City Hotel thô trước khi chuẩn hóa biến thể.\"},\n",
    "]\n",
    "for column in raw_df.columns:\n",
    "    if column == \"row_id\":\n",
    "        continue\n",
    "    before_pct = float(missing_survey.loc[missing_survey[\"column\"].eq(column), \"missing_pct\"].iloc[0])\n",
    "    after_pct = float(after_missing.loc[column, \"missing_pct\"]) if column in after_missing.index else float(\"nan\")\n",
    "    q01_rows.append({\n",
    "        \"metric\": f\"missing_pct_{column}\",\n",
    "        \"before\": before_pct,\n",
    "        \"after\": after_pct,\n",
    "        \"note\": \"Tỷ lệ thiếu (%); mẫu số lần lượt là 10.325 dòng nhập và số booking_id sạch.\",\n",
    "    })\n",
    "q01 = pd.DataFrame(q01_rows, columns=[\"metric\", \"before\", \"after\", \"note\"])\n",
    "save_table(q01, \"q01_before_after\")\n",
    "display(q01)\n"
   ]
