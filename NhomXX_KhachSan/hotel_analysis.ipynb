    "COUNTRY_MAP = {\n",
    "    \"PORTUGAL\": \"PRT\", \"UNITED KINGDOM\": \"GBR\", \"UK\": \"GBR\",\n",
    "    \"SPAIN\": \"ESP\", \"FRANCE\": \"FRA\", \"GERMANY\": \"DEU\",\n",
    "}\n",
    "country_original = df[\"country\"].astype(\"string\")\n",
    "country_text = country_original.str.strip()\n",
    "country_upper = country_text.str.upper()\n",
    "country_mapped = country_upper.map(COUNTRY_MAP).fillna(country_upper)\n",
    "country_valid = country_mapped.str.fullmatch(r\"[A-Z]{2,3}\", na=False)\n",
    "country_clean = country_mapped.where(country_valid, pd.NA).astype(\"string\")\n",
    "country_changed = country_original.fillna(\"<NA>\").ne(country_clean.fillna(\"<NA>\"))\n",
    "country_invalid = country_original.notna() & country_clean.isna()\n",
    "df[\"country\"] = country_clean\n",
    "log_step(\n",
    "    \"B7\", \"country\", \"Chuẩn hóa mã quốc gia\",\n",
    "    \"Ánh xạ tên quốc gia nguyên vẹn; mã còn lại phải là 2–3 chữ cái\",\n",
    "    \"Bỏ khoảng trắng, viết hoa, ánh xạ tên; giá trị sai thành thiếu\",\n",
    "    int(country_changed.sum()), int(country_changed.sum()), 0,\n",
    "    example_ids(raw_df, country_changed),\n",
    "    \"Áp dụng các ánh xạ được đề quy định; giữ nguyên CN, không gộp với CHN.\",\n",
    "    f\"{int(country_invalid.sum())} giá trị không hợp lệ thành thiếu; mã còn lại 2–3 chữ in hoa.\",\n",
    ")\n"
   ]
