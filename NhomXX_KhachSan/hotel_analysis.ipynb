    "merge_columns = [column for column in df.columns if column not in (\"row_id\", \"booking_id\")]\n",
    "ordered_df = df.sort_values([\"booking_id\", \"row_id\"], kind=\"stable\")\n",
    "merged_records = []\n",
    "lineage_rows = []\n",
    "conflict_rows = {column: [] for column in merge_columns}\n",
    "merged_row_count = 0\n",
    "\n",
    "for booking_id, group in ordered_df.groupby(\"booking_id\", sort=True, dropna=False):\n",
    "    group = group.sort_values(\"row_id\", kind=\"stable\")\n",
    "    row_ids = group[\"row_id\"].astype(str).tolist()\n",
    "    representative = row_ids[0]\n",
    "    merged_row_count += len(group) - 1\n",
    "    record = {\"booking_id\": booking_id}\n",
    "    for column in merge_columns:\n",
    "        values = group[column].dropna()\n",
    "        distinct = values.drop_duplicates()\n",
    "        if len(distinct) > 1:\n",
    "            conflict_rows[column].append(row_ids)\n",
    "        record[column] = values.iloc[0] if not values.empty else pd.NA\n",
    "    merged_records.append(record)\n",
    "    for row_id in row_ids:\n",
    "        lineage_rows.append({\n",
    "            \"row_id\": row_id,\n",
    "            \"booking_id\": booking_id,\n",
    "            \"status\": \"kept\" if row_id == representative else \"merged\",\n",
    "        })\n",
    "\n",
    "merged_df = pd.DataFrame(merged_records, columns=[\"booking_id\", *merge_columns])\n",
    "row_lineage = pd.DataFrame(lineage_rows, columns=LINEAGE_COLUMNS)\n",
    "for column, groups in conflict_rows.items():\n",
    "    if not groups:\n",
    "        continue\n",
    "    example_row_ids = \"; \".join(row_ids[0] for row_ids in groups[:5])\n",
    "    log_step(\n",
    "        \"B8\", column, \"Giá trị mâu thuẫn khi gộp booking_id\",\n",
    "        \"Trong một booking_id có từ hai giá trị không thiếu khác nhau\",\n",
    "        \"Chọn giá trị không thiếu từ row_id nhỏ nhất; ghi nhận nhóm xung đột\",\n",
    "        len(groups), len(groups), 0, example_row_ids,\n",
    "        \"Quy tắc xác định, lặp lại được và không đoán dữ liệu.\",\n",
    "        f\"{len(groups)} nhóm xung đột được giải quyết theo row_id nhỏ nhất.\",\n",
    "    )\n",
    "log_step(\n",
    "    \"B8\", \"booking_id\", \"Hợp nhất các dòng và lập truy vết\",\n",
    "    \"Nhóm theo booking_id sau khi chuẩn hóa B1; mỗi nhóm chọn một đại diện\",\n",
    "    \"Gộp giá trị đồng thuận; dòng đại diện kept, các dòng còn lại merged\",\n",
    "    merged_row_count, merged_row_count, merged_row_count,\n",
    "    example_ids(raw_df, raw_df[\"booking_id\"].astype(\"string\").str.strip().str.upper().duplicated(keep=\"first\")),\n",
    "    \"Một dòng/booking_id; row_lineage giữ đủ mọi row_id nguồn.\",\n",
    "    f\"{len(merged_df)} booking_id duy nhất; {len(row_lineage)} row_id được truy vết.\",\n",
    ")\n",
    "print(\"B8:\", len(merged_df), \"đặt phòng;\", merged_row_count, \"dòng được gộp.\")\n"
