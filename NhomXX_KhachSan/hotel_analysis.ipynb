    "lead_valid = clean_df[pd.to_numeric(clean_df[\"lead_time\"], errors=\"coerce\").notna()].copy()\n",
    "lead_valid[\"lead_time\"] = pd.to_numeric(lead_valid[\"lead_time\"], errors=\"coerce\")\n",
    "q04_rows = []\n",
    "for hotel in HOTELS:\n",
    "    values = lead_valid.loc[lead_valid[\"hotel\"].eq(hotel), \"lead_time\"].dropna()\n",
    "    q04_rows.append({\n",
    "        \"hotel\": hotel, \"n_bookings\": len(values),\n",
    "        \"mean\": values.mean(), \"median\": values.median(),\n",
    "        \"q1\": values.quantile(0.25), \"q3\": values.quantile(0.75),\n",
    "        \"max\": values.max(),\n",
    "    })\n",
    "q04 = pd.DataFrame(q04_rows)\n",
    "lead_valid[\"lead_time_group\"] = pd.cut(\n",
    "    lead_valid[\"lead_time\"], bins=[-0.5, 7.5, 30.5, 90.5, 180.5, float(\"inf\")],\n",
    "    labels=LEAD_GROUPS,\n",
    ")\n",
    "q04b_rows = []\n",
    "for label in LEAD_GROUPS:\n",
    "    group = lead_valid[lead_valid[\"lead_time_group\"].eq(label)]\n",
    "    known = group[\"is_canceled\"].notna()\n",
    "    n_canceled = int(group[\"is_canceled\"].eq(1).sum())\n",
    "    denominator = int(known.sum())\n",
    "    q04b_rows.append({\n",
    "        \"lead_time_group\": label, \"n_bookings\": len(group),\n",
    "        \"n_canceled\": n_canceled,\n",
    "        \"cancel_rate_pct\": round(n_canceled / denominator * 100, 2) if denominator else float(\"nan\"),\n",
    "    })\n",
    "q04_b = pd.DataFrame(q04b_rows)\n",
    "save_table(q04, \"q04_leadtime_stats\")\n",
    "save_table(q04_b, \"q04_leadtime_cancel\")\n",
    "display(q04)\n",
    "display(q04_b)\n",
    "fig, ax = plt.subplots(figsize=FIGSIZE)\n",
    "bars = ax.bar(q04_b[\"lead_time_group\"].astype(str), q04_b[\"cancel_rate_pct\"], color=\"#557C8A\")\n",
    "ax.bar_label(bars, labels=[f\"{x:.1f}%\" for x in q04_b[\"cancel_rate_pct\"]], padding=3)\n",
    "ax.set_ylim(0, max(5, float(q04_b[\"cancel_rate_pct\"].max()) * 1.18))\n",
    "finish_chart(\n",
    "    ax, \"Tỷ lệ hủy theo nhóm thời gian đặt trước\", \"Lead time (ngày)\", \"Tỷ lệ hủy (%)\",\n",
    "    note=f\"n = {len(lead_valid)} đặt phòng có lead_time hợp lệ; tỷ lệ dùng mẫu số có is_canceled; không loại đặt phòng theo khách sạn. Nguồn: outputs/tables/q04_leadtime_cancel.csv\",\n",
    ")\n",
    "fig.tight_layout()\n",
    "save_fig(fig, \"fig03_leadtime_cancel\")\n",
    "plt.show()\n"
   ]
  },
