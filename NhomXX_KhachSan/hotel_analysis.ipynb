    "country_valid = clean_df[clean_df[\"country\"].notna()].copy()\n",
    "missing_country = int(clean_df[\"country\"].isna().sum())\n",
    "country_group = country_valid.groupby(\"country\", sort=False)\n",
    "q05_all = country_group.agg(\n",
    "    n_bookings=(\"booking_id\", \"size\"),\n",
    "    n_canceled=(\"is_canceled\", lambda values: int(values.eq(1).sum())),\n",
    "    n_status=(\"is_canceled\", \"count\"),\n",
    ").reset_index()\n",
    "q05_all[\"pct_of_all_bookings\"] = q05_all[\"n_bookings\"] / len(clean_df) * 100\n",
    "q05_all[\"cancel_rate_pct\"] = (\n",
    "    q05_all[\"n_canceled\"] / q05_all[\"n_status\"].replace(0, float(\"nan\")) * 100\n",
    ")\n",
    "q05 = q05_all.sort_values([\"n_bookings\", \"country\"], ascending=[False, True]).head(10).copy()\n",
    "q05.insert(0, \"rank\", range(1, len(q05) + 1))\n",
    "q05 = q05[[\"rank\", \"country\", \"n_bookings\", \"pct_of_all_bookings\", \"cancel_rate_pct\"]]\n",
    "q05[[\"pct_of_all_bookings\", \"cancel_rate_pct\"]] = q05[[\"pct_of_all_bookings\", \"cancel_rate_pct\"]].round(2)\n",
    "print(f\"Đặt phòng thiếu country: {missing_country} trên {len(clean_df)}.\")\n",
    "save_table(q05, \"q05_top10_country\")\n",
    "display(q05)\n",
    "country_plot = q05.sort_values(\"n_bookings\")\n",
    "fig, ax = plt.subplots(figsize=(9, 6))\n",
    "bars = ax.barh(country_plot[\"country\"], country_plot[\"n_bookings\"], color=\"#557C8A\")\n",
    "ax.bar_label(bars, padding=3)\n",
    "ax.set_xlim(0, max(1, int(country_plot[\"n_bookings\"].max()) * 1.16))\n",
    "finish_chart(\n",
    "    ax, \"10 quốc gia có nhiều đặt phòng nhất\", \"Số đặt phòng\", \"Mã quốc gia\",\n",
    "    note=f\"n = {len(clean_df)} đặt phòng; tỷ trọng trên toàn bộ đặt phòng gồm {missing_country} thiếu country. Nguồn: outputs/tables/q05_top10_country.csv\",\n",
    ")\n",
    "fig.tight_layout()\n",
    "save_fig(fig, \"fig04_top10_country\")\n",
    "plt.show()\n"
   ]
  },
